# Copy to .env, replace model IDs/endpoints, then run npm run start:configured.
# Port 8788 is reserved for the explicit local fixture UI; retrieval here is only a placeholder.
# Enable execution plane
PPL_EXECUTION_ENABLED=1

# Agent model - example vLLM
PPL_AGENT_PRESET=vllm
PPL_AGENT_ENDPOINT=http://127.0.0.1:8001/v1/chat/completions
PPL_AGENT_MODEL=your-agent-model-id

# Independent semantic Judge - example vLLM
PPL_JUDGE_PRESET=vllm
PPL_JUDGE_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
PPL_JUDGE_MODEL=your-judge-model-id
PPL_MODEL_INDEPENDENCE=required

# Research retrieval: http | searxng
PPL_RETRIEVAL_KIND=http
PPL_RETRIEVAL_ENDPOINT=http://127.0.0.1:8790/retrieve

# Keep remote endpoints disabled unless explicitly intended.
PPL_ALLOW_REMOTE_ENDPOINTS=0

# Per-request HTTP deadline and decompressed response size (non-streaming product calls).
PPL_HTTP_TIMEOUT_MS=30000
PPL_HTTP_MAX_RESPONSE_BYTES=2097152
PPL_RETRIEVAL_MAX_DOCUMENT_CHARS=50000

# Optional; required only for qualification scopes research/all. Set a real question.
# PPL_QUALIFY_QUESTION="Your research question for the configured retrieval service"
# Do not use role labels to manufacture model independence; same model IDs are rejected in required mode.
