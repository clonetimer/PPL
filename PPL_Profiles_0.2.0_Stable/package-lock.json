{
  "name": "ppl-profiles",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ppl-profiles",
      "version": "0.2.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@ppl/profile-core": {
      "resolved": "packages/profile-core",
      "link": true
    },
    "node_modules/@ppl/profile-research": {
      "resolved": "packages/profile-research",
      "link": true
    },
    "node_modules/@ppl/profile-runtime": {
      "resolved": "packages/profile-runtime",
      "link": true
    },
    "node_modules/@ppl/profile-tutor": {
      "resolved": "packages/profile-tutor",
      "link": true
    },
    "packages/profile-core": {
      "name": "@ppl/profile-core",
      "version": "0.2.0"
    },
    "packages/profile-research": {
      "name": "@ppl/profile-research",
      "version": "0.2.0",
      "dependencies": {
        "@ppl/profile-core": "0.2.0"
      }
    },
    "packages/profile-runtime": {
      "name": "@ppl/profile-runtime",
      "version": "0.2.0",
      "dependencies": {
        "@ppl/profile-core": "0.2.0",
        "@ppl/profile-research": "0.2.0",
        "@ppl/profile-tutor": "0.2.0"
      }
    },
    "packages/profile-tutor": {
      "name": "@ppl/profile-tutor",
      "version": "0.2.0",
      "dependencies": {
        "@ppl/profile-core": "0.2.0"
      }
    }
  }
}
