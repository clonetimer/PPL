{
  "name": "ppl-app-observatory",
  "version": "0.5.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ppl-app-observatory",
      "version": "0.5.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@ppl/app-adapter-dsh": {
      "resolved": "packages/app-adapter-dsh",
      "link": true
    },
    "node_modules/@ppl/app-core": {
      "resolved": "packages/app-core",
      "link": true
    },
    "node_modules/@ppl/app-standalone": {
      "resolved": "packages/app-standalone",
      "link": true
    },
    "node_modules/@ppl/app-ui": {
      "resolved": "packages/app-ui",
      "link": true
    },
    "packages/app-adapter-dsh": {
      "name": "@ppl/app-adapter-dsh",
      "version": "0.5.0",
      "dependencies": {
        "@ppl/app-core": "0.5.0"
      },
      "bin": {
        "ppl-app-dsh-project": "src/cli.mjs"
      }
    },
    "packages/app-core": {
      "name": "@ppl/app-core",
      "version": "0.5.0"
    },
    "packages/app-standalone": {
      "name": "@ppl/app-standalone",
      "version": "0.5.0",
      "dependencies": {
        "@ppl/app-core": "0.5.0",
        "@ppl/app-ui": "0.5.0"
      },
      "bin": {
        "ppl-observatory": "server.mjs"
      }
    },
    "packages/app-ui": {
      "name": "@ppl/app-ui",
      "version": "0.5.0",
      "dependencies": {
        "@ppl/app-core": "0.5.0"
      }
    }
  }
}
