{
  "name": "@ppl/provider-openai-compatible-local",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Stable capability-driven OpenAI-compatible local LLM provider for PPL; LM Studio + Qwen3.5-0.8B live-certified.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "probe": "node bin/probe-local-provider.mjs",
    "check": "npm test && node bin/probe-local-provider.mjs --dry-run",
    "live:cert": "node bin/live-local-cert.mjs"
  },
  "dependencies": {
    "ppl-llm-host-adapter": "0.1.0"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./capabilities": "./src/capabilities.mjs",
    "./chat": "./src/openai-compatible-chat.mjs",
    "./discovery": "./src/discovery.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "vendor/"
  ],
  "bundledDependencies": [
    "ppl-llm-host-adapter"
  ]
}
